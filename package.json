{
  "name": "anu",
  "version": "1.0.0",
  "private": true,
  "description": "ANU: a personal helper for learning and following defense tech, with a daily brief, a static JSON API and a site.",
  "type": "module",
  "scripts": {
    "collect": "tsx src/collect.ts",
    "daily:claude": "tsx src/daily.ts",
    "build:api": "tsx src/build-api.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "kb": "tsx src/kb-cli.ts",
    "ask": "tsx src/agent.ts",
    "app": "vite build && tsx src/server.ts",
    "app:dev": "tsx src/server.ts & vite",
    "enrich": "tsx src/enrich.ts",
    "build:pages": "VITE_STATIC=1 vite build --outDir ../public/app --emptyOutDir --base ./"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^4.3.1",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
